[Unit]
Description=Einfach Hausen notification outbox dispatcher
After=einfach-hausen.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/einfach-hausen
EnvironmentFile=/etc/einfach-hausen.env
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.0/bin/node scripts/dispatch-notifications.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/einfach-hausen
