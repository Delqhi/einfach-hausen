  },
  "lanes": [
    {
      "id": "main",
      "label": "Auftragsphasen"
    },
    {
      "id": "waiting",
      "label": "Warten / Entscheidung"
    },
    {
      "id": "terminal",
      "label": "Abschluss"
    }
  ],
  "states": [
    {
      "id": "request",
