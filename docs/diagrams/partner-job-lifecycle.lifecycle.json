  "cards": [
    {
      "dot": "emerald",
      "title": "Berechtigung",
      "items": [
        "AN: Anfragen, Angebote und Zuweisung verwalten",
        "AUS: nur eigene zugewiesene Aufträge",
        "Keine ERP-Rollenmatrix"
      ]
    },
    {
      "dot": "violet",
      "title": "Hausgedächtnis",
      "items": [
        "Abgeschlossene Arbeit bleibt in der Haus-Historie",
        "Rechnung, Kontakt und relevante Nachweise bleiben auffindbar"
      ]
    }
