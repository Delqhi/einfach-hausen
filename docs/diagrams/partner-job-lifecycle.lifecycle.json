      "col": 0,
      "step": "01"
    },
    {
      "id": "quote",
      "type": "active",
      "label": "Angebot",
      "sublabel": "Umfang + Preis + Termin",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "booked",
      "type": "active",
      "label": "Gebucht",
      "sublabel": "bewusste Kundenwahl",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "assigned",
      "type": "active",
      "label": "Zugewiesen",
      "sublabel": "konkreter Ansprechpartner",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "invoice",
      "type": "active",
      "label": "Rechnung",
      "sublabel": "nach Leistung",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "awaiting",
