      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "from": "request",
      "to": "cancelled",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    }
