    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "Abgelehnt / storniert",
      "sublabel": "kein versteckter Abschluss",
      "lane": "terminal",
      "col": 0,
      "tag": "terminal",
      "width": 144
    }
  ],
  "transitions": [
    {
      "from": "request",
      "to": "quote",
      "variant": "emphasis"
    },
    {
      "from": "quote",
      "to": "booked",
      "variant": "emphasis"
    },
    {
      "from": "booked",
      "to": "assigned",
      "variant": "emphasis"
    },
    {
      "from": "assigned",
      "to": "invoice",
      "variant": "emphasis"
    },
    {
      "from": "invoice",
      "to": "done",
