# Production HA — Supabase ist Primary, SQLite nur Fallback/Local Dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase Postgres + Storage (HA Primary) — via Infisical, nie committen
DATABASE_URL=
# Server identity authority. Defaults to Supabase; AUTH_MODE=local is development-only.
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=einfach-hausen
# SQLite Fallback nur für npm run dev / Notfall
DATABASE_PATH=./data/einfach-hausen.db

# Optional OpenAI-compatible AI gateway. If AI_API_KEY is empty, OMNIROUTE_MASTER_KEY is also accepted.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_MODEL=auto/best-fast
AI_API_KEY=
OMNIROUTE_MASTER_KEY=

# Live payment integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# Admin access (use a long random value)
ADMIN_PASSWORD=

# Rewarded-ad receipt verification (server-only, never commit values).
# Production fails closed without a secret; dev/E2E may set ALLOW_UNSIGNED_AD_CREDITS=1.
AD_RECEIPT_SECRET=
ALLOW_UNSIGNED_AD_CREDITS=

# Business model: 0 % commission per customer job.
# Partner revenue comes from FREE/START/PRO/PREMIUM subscriptions.

# WhatsApp Cloud API — optional second customer channel
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional local/project-neutral lead source used by /admin/crm sync
BUSINESS_RESEARCH_DB_PATH=
